{
  "name": "judokon-2600",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "dev:sim": "vite --mode simulator",
    "dev:chaos": "vite --mode chaos",
    "build": "tsc -p tsconfig.api.json && tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:sim": "playwright test --config=playwright.sim.config.ts",
    "test:e2e:chaos": "playwright test --config=playwright.chaos.config.ts",
    "test:coverage": "vitest run --coverage",
    "fallow:coverage": "npm run test:coverage && npx fallow --coverage coverage/coverage-final.json",
    "test:watch": "vitest",
    "lint": "eslint .",
    "docs:check": "node scripts/check-markdown-links.mjs && markdownlint-cli2 README.md \"docs/**/*.md\"",
    "check": "npm run lint && npm run test && npm run docs:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "fallow": "^3.43.2",
    "jsdom": "^31.0.1",
    "markdownlint-cli2": "^0.24.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@a2ui/web_core": "0.16.1",
    "@vercel/functions": "^3.11.3",
    "@vercel/speed-insights": "^2.1.0"
  },
  "overrides": {
    "glob": "14.0.2",
    "katex": "^0.18.2",
    "zod": "^4.6.6"
  }
}
