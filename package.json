{
  "name": "judokon-2600",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.api.json && tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fallow:coverage": "npm run test:coverage && npx fallow --coverage coverage/coverage-final.json",
    "test:watch": "vitest",
    "lint": "eslint .",
    "docs:check": "node scripts/check-markdown-links.mjs && markdownlint-cli2 README.md \"docs/**/*.md\"",
    "check": "npm run lint && npm run test && npm run docs:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "fallow": "^3.37.0",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.4",
    "@vercel/speed-insights": "^2.0.0"
  },
  "overrides": {
    "katex": "^0.18.2",
    "zod": "^4.6.6"
  }
}
